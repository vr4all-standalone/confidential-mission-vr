# hotd2-vr: models ripped from the game are Sega data, never commit them
hands*.bin
staff*.bin
HND1*.bin
gun-*.bin

# hotd2-vr: the models a release build comes with (guns/, controllers/, CREDITS.txt) are other people's
# work under their own licences: filled by hand for a build (README, Releasing), never committed
cm-vr/models/

# hotd2-vr: VR Light Gun Hub's release key lives outside the repository (make-release-key.ps1);
# never commit a key or its password. Flycast's own playstore.jks stays tracked.
release-signing.properties
*.jks
!shell/android-studio/playstore.jks
# (nor any other key store or certificate; Flycast's debug.keystore and sign_cert.pfx stay tracked)
*.keystore
!shell/android-studio/debug.keystore
*.p12
*.pfx
!shell/uwp/sign_cert.pfx
